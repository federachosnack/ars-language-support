{
	"name": "ARS",
	"scopeName": "source.ars",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#rule_declarations" },
		{ "include": "#set_declarations" },
		{ "include": "#section_keywords" },
		{ "include": "#sets_and_blocks" },
		{ "include": "#actions" },
		{ "include": "#network_events" },
		{ "include": "#observables" },
		{ "include": "#operators" },
		{ "include": "#strings" },
		{ "include": "#ip_addresses" },
		{ "include": "#numbers" },
		{ "include": "#punctuation" },
		{ "include": "#variables" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.ars",
					"match": "//.*$"
				},
				{
					"name": "comment.block.parentheses.ars",
					"begin": "\\(\\*",
					"end": "\\*\\)",
					"patterns": [
						{ "include": "#comment_tags" }
					]
				}
			]
		},
		"comment_tags": {
			"patterns": [
				{
					"name": "storage.type.class.todo.ars",
					"match": "(?i)\\b(TODO|FIXME|NOTE|BUG|HACK|WARN|WARNING)\\b:?"
				}
			]
		},
		"rule_declarations": {
			"patterns": [
				{
					"match": "(?i)\\b(DEFINE)\\s+(AR|VR|access\\s+rule|validation\\s+rule)\\s+(?:(\"[^\"]*\")|([a-zA-Z_][a-zA-Z0-9_]*))",
					"captures": {
						"1": { "name": "keyword.control.define.ars" },
						"2": { "name": "storage.type.rule.ars" },
						"3": { "name": "entity.name.function.rule.string.ars" },
						"4": { "name": "entity.name.function.rule.identifier.ars" }
					}
				}
			]
		},
		"set_declarations": {
			"patterns": [
				{
					"match": "(?i)\\b(DEFINE)\\s+(ipset|urlset|set)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)",
					"captures": {
						"1": { "name": "keyword.control.define.ars" },
						"2": { "name": "storage.type.set.ars" },
						"3": { "name": "entity.name.type.set.ars" },
						"4": { "name": "keyword.operator.assignment.ars" }
					}
				}
			]
		},
		"section_keywords": {
			"patterns": [
				{
					"name": "keyword.control.section.ars",
					"match": "(?i)\\b(DEFINE|CONDITION|ACTION|VAR)\\b"
				},
				{
					"name": "keyword.control.temporal.ars",
					"match": "(?i)\\b(next|EXISTS)\\b"
				},
				{
					"name": "storage.type.ars",
					"match": "(?i)\\b(AR|VR|ipset|urlset|set)\\b"
				}
			]
		},
		"sets_and_blocks": {
			"patterns": [
				{
					"name": "meta.block.braces.ars",
					"begin": "\\{",
					"beginCaptures": {
						"0": { "name": "punctuation.section.braces.begin.ars" }
					},
					"end": "\\}",
					"endCaptures": {
						"0": { "name": "punctuation.section.braces.end.ars" }
					},
					"patterns": [
						{ "include": "#comments" },
						{ "include": "#sets_and_blocks" },
						{ "include": "#actions" },
						{ "include": "#network_events" },
						{ "include": "#observables" },
						{ "include": "#strings" },
						{ "include": "#ip_addresses" },
						{
							"name": "string.unquoted.url-pattern.ars",
							"match": "/[a-zA-Z0-9_.*\\-/]*"
						},
						{ "include": "#punctuation" },
						{ "include": "#variables" }
					]
				}
			]
		},
		"actions": {
			"patterns": [
				{
					"match": "(?i)\\b(Enable|Disable)\\s+(AR|VR|access\\s+rule|validation\\s+rule)\\b",
					"captures": {
						"1": { "name": "support.function.rule-toggle.ars" },
						"2": { "name": "storage.type.rule.ars" }
					}
				},
				{
					"match": "(?i)\\b(Mysql)\\.(append)\\b",
					"captures": {
						"1": { "name": "support.class.database.ars" },
						"2": { "name": "support.function.database.ars" }
					}
				},
				{
					"match": "(?i)\\b(scm)\\.(manage|give)\\b",
					"captures": {
						"1": { "name": "support.class.scm.ars" },
						"2": { "name": "support.function.scm.ars" }
					}
				},
				{
					"match": "(?i)\\b(http|tcp)\\.(redirect)\\b",
					"captures": {
						"1": { "name": "support.class.protocol.ars" },
						"2": { "name": "support.function.redirect.ars" }
					}
				},
				{
					"match": "(?i)\\b(report)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
					"captures": {
						"1": { "name": "keyword.other.action.report.ars" },
						"2": { "name": "entity.name.tag.logtarget.ars" }
					}
				},
				{
					"name": "support.function.action.ars",
					"match": "(?i)\\b(answer|cat|trace|bandwidth|http\\.answer\\.header\\.replace|http_answer_header_replace|tcp_redirect|http_redirect)\\b"
				},
				{
					"match": "(?i)\\b(add|del)\\b(.*?)\\b(to|from)\\s+(set)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s+([0-9]+))?",
					"captures": {
						"1": { "name": "support.function.set-op.ars" },
						"2": {
							"patterns": [
								{ "include": "#actions" },
								{ "include": "#sets_and_blocks" },
								{ "include": "#strings" },
								{ "include": "#observables" },
								{ "include": "#variables" }
							]
						},
						"3": { "name": "keyword.operator.word.ars" },
						"4": { "name": "storage.type.set.ars" },
						"5": { "name": "entity.name.type.set.ars" },
						"6": { "name": "constant.numeric.ttl.ars" }
					}
				},
				{
					"match": "(?i)\\b(set)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(@)\\s*(\"[^\"]*\"|[a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)",
					"captures": {
						"1": { "name": "storage.type.set.ars" },
						"2": { "name": "entity.name.type.set.ars" },
						"3": { "name": "keyword.operator.at.ars" },
						"4": { "name": "variable.parameter.key.ars" },
						"5": { "name": "keyword.operator.assignment.ars" }
					}
				},
				{
					"name": "support.function.set-op.ars",
					"match": "(?i)\\b(add|del)\\b"
				}
			]
		},
		"network_events": {
			"patterns": [
				{
					"match": "(?i)\\b(net)\\.(send|recv|connect|disconnect|accept|close|error)\\b",
					"captures": {
						"1": { "name": "support.class.protocol.ars" },
						"2": { "name": "constant.language.network-event.ars" }
					}
				},
				{
					"match": "\\b(HTTP)\\.(GET|POST|PUT|DELETE|HEAD|OPTIONS|PATCH|CONNECT|TRACE)\\b",
					"captures": {
						"1": { "name": "support.class.http.ars" },
						"2": { "name": "constant.language.http-method.ars" }
					}
				}
			]
		},
		"observables": {
			"patterns": [
				{
					"match": "(?i)\\b(http(?:\\.answer)?|obs)\\.(header|query|data|cookie|tag)\\s*(\\[)\\s*(\"[^\"]*\"|'[^']*'|[^\\]]+)\\s*(\\])",
					"captures": {
						"1": { "name": "support.class.protocol.ars" },
						"2": { "name": "support.variable.property.map.ars" },
						"3": { "name": "punctuation.section.brackets.begin.ars" },
						"4": { "name": "string.quoted.double.key.ars" },
						"5": { "name": "punctuation.section.brackets.end.ars" }
					}
				},
				{
					"match": "(?i)\\b(http\\.answer)\\.(code|cookie|header|data)\\b",
					"captures": {
						"1": { "name": "support.class.protocol.ars" },
						"2": { "name": "support.variable.property.http.ars" }
					}
				},
				{
					"match": "(?i)\\b(http)\\.(host|url|uri|method|code|status|header|query|data|cookie|version|answer)\\b",
					"captures": {
						"1": { "name": "support.class.protocol.ars" },
						"2": { "name": "support.variable.property.http.ars" }
					}
				},
				{
					"match": "(?i)\\b(net(?:\\.tcp)?)\\.(ipdst|ipsrc|portdst|portsrc|sesid|result|proto)\\b",
					"captures": {
						"1": { "name": "support.class.protocol.ars" },
						"2": { "name": "support.variable.property.net.ars" }
					}
				},
				{
					"match": "(?i)\\b(obs)\\.(name|time|obsid|stime|etime|tag|event)\\b",
					"captures": {
						"1": { "name": "support.class.observable.ars" },
						"2": { "name": "support.variable.property.obs.ars" }
					}
				},
				{
					"match": "(?i)\\b(sa)\\.(os|logged_user|process_name)\\b",
					"captures": {
						"1": { "name": "support.class.agent.ars" },
						"2": { "name": "support.variable.property.agent.ars" }
					}
				},
				{
					"match": "(?i)\\b(agent)\\.(id)\\b",
					"captures": {
						"1": { "name": "support.class.agent.ars" },
						"2": { "name": "support.variable.property.agent.ars" }
					}
				},
				{
					"name": "support.variable.observable.constant.ars",
					"match": "(?i)\\b(SA_OS|SA_LOGGED_USER|SA_PROCESS_NAME|OBS_NAME|OBS_TIME|OBS_OBSID|OBS_STIME|OBS_ETIME|OBS_TAG|OBS_EVENT|NET_TCP_IPDST|NET_TCP_IPSRC|NET_RESULT|NET_TCP_SESID|HTTP_METHOD|HTTP_COOKIE|HTTP_HEADER|HTTP_QUERY|HTTP_DATA|HTTP_ANSWER_CODE|HTTP_ANSWER_COOKIE|HTTP_ANSWER_HEADER|HTTP_ANSWER_DATA|time)\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.logical.not.ars",
					"match": "!"
				},
				{
					"name": "keyword.operator.at.ars",
					"match": "@"
				},
				{
					"name": "keyword.operator.word.ars",
					"match": "(?i)\\b(is\\s+not\\s+in|is\\s+in|is\\s+not|is|in|from|to|and|or|not)\\b"
				},
				{
					"name": "constant.language.boolean.ars",
					"match": "(?i)\\b(true|false)\\b"
				},
				{
					"name": "keyword.operator.comparison.ars",
					"match": "(==|!=|<=|>=|<|>|=)"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.ars",
					"begin": "\"",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.string.begin.ars" }
					},
					"end": "\"",
					"endCaptures": {
						"0": { "name": "punctuation.definition.string.end.ars" }
					},
					"patterns": [
						{
							"name": "constant.character.escape.ars",
							"match": "\\\\[nrt\"'\\\\]"
						},
						{
							"match": "\\b([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3})(:([0-9]{1,5}))?\\b",
							"captures": {
								"1": { "name": "constant.other.ip-in-string.ars" },
								"2": { "name": "punctuation.separator.port.ars" },
								"3": { "name": "constant.numeric.port.ars" }
							}
						},
						{
							"match": "(</?)([a-zA-Z0-9]+)?(>)",
							"captures": {
								"1": { "name": "punctuation.definition.tag.html.ars" },
								"2": { "name": "entity.name.tag.html.ars" },
								"3": { "name": "punctuation.definition.tag.html.ars" }
							}
						}
					]
				}
			]
		},
		"ip_addresses": {
			"patterns": [
				{
					"match": "([0-9*]+\\.[0-9*]+\\.[0-9*]+\\.[0-9*]+)(?:(:)([0-9*]+))?",
					"captures": {
						"1": { "name": "constant.other.wildcard-ip.ars" },
						"2": { "name": "punctuation.separator.port.ars" },
						"3": { "name": "constant.numeric.port.ars" }
					}
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.integer.ars",
					"match": "\\b[0-9]+\\b"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.terminator.statement.ars",
					"match": ";"
				},
				{
					"name": "punctuation.separator.comma.ars",
					"match": ","
				},
				{
					"name": "punctuation.section.brackets.ars",
					"match": "\\[|\\]"
				},
				{
					"name": "punctuation.section.parens.ars",
					"match": "\\(|\\)"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"name": "variable.other.set-reference.ars",
					"match": "(?i)(?<=\\bin\\s+)[a-zA-Z_][a-zA-Z0-9_]*\\b"
				},
				{
					"name": "variable.other.readwrite.ars",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
				}
			]
		}
	}
}